{
  "name": "simulator-start-config-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wasm": "cd ../rust && wasm-pack build --target web --out-dir ../web/public/wasm --out-name karpador_sim --release",
    "typecheck": "tsc --noEmit",
